# =============================================================================
# AI Recursive Query Tuning - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# --- OpenAI Configuration ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# --- Django Configuration ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://172.168.1.95:3082,http://localhost:3082

# --- PostgreSQL Configuration ---
POSTGRES_DB=recursive_query_db
POSTGRES_USER=rqt_user
POSTGRES_PASSWORD=rqt_secure_password_2024
POSTGRES_HOST=postgres
POSTGRES_PORT=5532

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6479
REDIS_URL=redis://redis:6479/0

# --- ChromaDB Configuration ---
CHROMA_HOST=chromadb
CHROMA_PORT=8142

# --- Service Ports ---
FRONTEND_PORT=3082
GATEWAY_PORT=3083
BACKEND_PORT=8042
POSTGRES_EXTERNAL_PORT=5532
REDIS_EXTERNAL_PORT=6479
CHROMA_EXTERNAL_PORT=8142
LANGFUSE_PORT=3084

# --- LangSmith Configuration ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=recursive-query-tuning
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Langfuse Configuration ---
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=http://langfuse:3084
NEXT_PUBLIC_SIGN_UP_DISABLED=false
LANGFUSE_INIT_ORG_ID=rqt-org
LANGFUSE_INIT_ORG_NAME=RQT Organization
LANGFUSE_INIT_PROJECT_ID=rqt-project
LANGFUSE_INIT_PROJECT_NAME=Recursive Query Tuning
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-rqt-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-rqt-dev
LANGFUSE_INIT_USER_EMAIL=admin@rqt.local
LANGFUSE_INIT_USER_PASSWORD=admin123
LANGFUSE_INIT_USER_NAME=Admin

# --- MCP Server Configuration ---
MCP_SERVER_PORT=8043
MCP_SERVER_HOST=0.0.0.0

# --- A2A Protocol Configuration ---
A2A_DISCOVERY_PORT=8044
A2A_PROTOCOL_VERSION=0.1

# --- Host Configuration ---
HOST_IP=172.168.1.95
